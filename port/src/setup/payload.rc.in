// Generated by CMake from payload.rc.in -- the absolute paths are resolved at configure time.
// Plain ASCII only in this file (the resource compiler mangles escapes; Tom & Jerry lesson).
#include <windows.h>
#include "setup/payload_ids.h"

IDI_TTT2SETUP          ICON    "@TTT2_SETUP_ICON@"
1                      24      "@TTT2_SETUP_MANIFEST@"

IDR_GAME_EXE           RCDATA  "@TTT2_GAME_EXE@"
IDR_STEAM_API          RCDATA  "@TTT2_STEAM_DLL@"
IDR_MSVCP140           RCDATA  "@CRT_MSVCP140@"
IDR_MSVCP140_ATOMIC    RCDATA  "@CRT_MSVCP140_ATOMIC@"
IDR_VCRUNTIME140       RCDATA  "@CRT_VCRUNTIME140@"
IDR_VCRUNTIME140_1     RCDATA  "@CRT_VCRUNTIME140_1@"
@TTT2_OPTIONAL_PAYLOAD_RC@IDR_README             RCDATA  "@TTT2_README_TXT@"
IDR_INSTALLER_BG       RCDATA  "@TTT2_SETUP_BG@"

IDD_MAIN DIALOGEX 0, 0, 320, 250
// Borderless, painted with installer_bg.png; setup_main.cpp sizes the window to the art and lays
// the controls over the boxes drawn in it (kArtLayout). The coordinates below are placeholders.
STYLE DS_SETFONT | WS_POPUP | WS_CLIPCHILDREN | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Install Tekken Tag Tournament 2 (PC port)"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_ISO_PATH, 0, 0, 10, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL         "Browse", IDC_ISO_BROWSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    EDITTEXT        IDC_TU_PATH, 0, 0, 10, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL         "Browse", IDC_TU_BROWSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    EDITTEXT        IDC_DEST_PATH, 0, 0, 10, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL         "Browse", IDC_DEST_BROWSE, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Create a &Desktop shortcut", IDC_SC_DESKTOP, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Add to the &Start menu", IDC_SC_STARTMENU, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "Install game", IDC_INSTALL, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "X", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", 0x0, 0, 0, 10, 10
    LTEXT           "", IDC_STATUS, 0, 0, 10, 10, SS_ENDELLIPSIS
    RTEXT           "by ThatCaliKid760", IDC_CREDIT, 0, 0, 10, 10
END

IDD_UNINSTALL DIALOGEX 0, 0, 268, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Uninstall Tekken Tag Tournament 2 (PC port)"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_UN_TEXT, 10, 10, 248, 34
    CONTROL         "Also delete my &saved games, profiles and settings", IDC_UN_KEEPSAVES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 50, 240, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 10, 66, 248, 10
    DEFPUSHBUTTON   "&Uninstall", IDOK, 144, 88, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 204, 88, 54, 16
END

1 VERSIONINFO
FILEVERSION    @TTT2_VERSION_COMMAS@
PRODUCTVERSION @TTT2_VERSION_COMMAS@
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Tekken Tag Tournament 2 - PC port installer"
            VALUE "FileVersion",     "@TTT2_VERSION@"
            VALUE "ProductName",     "Tekken Tag Tournament 2 (PC port)"
            VALUE "ProductVersion",  "@TTT2_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
